# Copy this file to .env on the server and replace every CHANGE_ME value.

GCINSIDE_IMAGE_TAG=local

# Public HTTPS reverse proxy.
GCINSIDE_DOMAIN=example.com
ACME_EMAIL=admin@example.com
HTTP_HOST_PORT=80
HTTPS_HOST_PORT=443
PUBLIC_HTTP_URL=http://example.com:25128

# Local-only app debug port. Caddy proxies to app:3000 inside Docker.
APP_HOST_PORT=3000

# PostgreSQL
POSTGRES_DB=gcinside
POSTGRES_USER=gcinside
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_HOST_PORT=5432
DATABASE_SSL=false

# Redis
REDIS_HOST_PORT=6379

# NATS JetStream queue
NATS_HOST_PORT=4222
NATS_MONITOR_HOST_PORT=8222

# MinIO object storage
MINIO_ROOT_USER=gcinside
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_API_HOST_PORT=9000

# App secrets
NEXTAUTH_URL=http://example.com:25128
NEXTAUTH_SECRET=CHANGE_ME_NEXTAUTH_SECRET
AUTH_SECRET=CHANGE_ME_AUTH_SECRET
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://example.com:25128/api/auth/callback
ADMIN_EMAILS=admin@example.com

# Anti-abuse rollout defaults
ABUSE_ENABLED=true
ABUSE_HASH_SALT=CHANGE_ME_ABUSE_HASH_SALT
ABUSE_RULE_VERSION=rules-v1
ABUSE_ENABLE_HARD_BLOCK=false
ABUSE_FAIL_OPEN=true
ABUSE_SHADOW_MODE=false
ABUSE_AI_MODE=SHADOW
ABUSE_ACTIVE_MODEL=mock-risk-v1
ABUSE_CANARY_RATIO=0
ABUSE_MODEL_ROLLBACK=false
AI_INFERENCE_ENABLED=true
AI_INFERENCE_TIMEOUT_MS=1200
AI_INFERENCE_RETRIES=1

# AI inference
AI_MODEL_VERSION=mock-risk-v1
AI_INFERENCE_TOKEN=CHANGE_ME_INTERNAL_TOKEN

# Object storage credentials used by app/worker/pipeline clients when implemented.
AWS_ACCESS_KEY_ID=gcinside
AWS_SECRET_ACCESS_KEY=CHANGE_ME_STRONG_MINIO_PASSWORD
AWS_REGION=ap-northeast-2
S3_ENDPOINT=http://object-storage:9000
S3_FORCE_PATH_STYLE=true
GCINSIDE_FEATURE_BUCKET=gcinside-features
GCINSIDE_MODEL_BUCKET=gcinside-models
