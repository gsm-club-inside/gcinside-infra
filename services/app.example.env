## Production env template for gcinside-app
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_HOST:5432/gcinside
DIRECT_URL=postgresql://USER:PASSWORD@PRIVATE_HOST:5432/gcinside
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=https://app.gcinside.example/api/auth/callback
ADMIN_EMAILS=
SESSION_SECRET=
ABUSE_HASH_SALT=
ABUSE_RULE_VERSION=rules-v1
ABUSE_ENABLE_HARD_BLOCK=false
ABUSE_FAIL_OPEN=true
ABUSE_SHADOW_MODE=false
AI_INFERENCE_ENABLED=true
AI_INFERENCE_URL=http://ai-inference:8081
AI_INFERENCE_TOKEN=
AI_INFERENCE_TIMEOUT_MS=250
AI_INFERENCE_RETRIES=1
LOG_LEVEL=info
